    def start_rl_mode_conditionally(self):
        """Start RL mode (same as deploy.py)"""
        self.logger.info("Starting RL mode")
        
        # Create prepare command using deploy_booster function
        create_prepare_cmd(self.low_cmd, self.cfg)
        
        # Initialize target arrays (SAME AS deploy.py)
        for i in range(B1JointCnt):
            self.dof_target[i] = self.low_cmd.motor_cmd[i].q
            self.filtered_dof_target[i] = self.low_cmd.motor_cmd[i].q
        
        # Send prepare command
        self._send_cmd(self.low_cmd)
        # Switch to custom mode (RL uses custom mode in SDK)
        if BOOSTER_SDK_AVAILABLE:
            self.client.ChangeMode(RobotMode.kCustom)
        
        self.rl_mode_started = True
        self.logger.info("RL mode activated")
    
    def control_loop(self):
        """Main control loop - handles all control logic"""
        if not self.running:
            return
        
        current_time = time.time()
        
        # 1. Send motor commands (only if in RL mode)
        self._send_motor_commands()
        
        # 2. Safety checks
        self._check_motor_command_timeout(current_time)
        self._check_joint_limits()
        
        # 3. Statistics logging
        if current_time - self.last_stats_time > 10.0:  # Every 10 seconds
            self._log_statistics()
            self.last_stats_time = current_time
    
    def _send_motor_commands(self):
        """Send motor commands to robot (only in RL mode)"""
        # Only send commands if robot is in RL mode and SDK is available
        if BOOSTER_SDK_AVAILABLE and self.robot_mode == 2:  # kRL
            self.low_cmd.cmd_type = LowCmdType.PARALLEL
            self._send_cmd(self.low_cmd)
        elif self.robot_mode != 2:
            # Log when not in RL mode (for debugging)
            if not hasattr(self, 'mode_warning_logged') or not self.mode_warning_logged:
                self.logger.debug(f"Not sending motor commands - robot mode: {self.robot_mode} (need mode 2 for RL)")
                self.mode_warning_logged = True
   
    def _check_motor_command_timeout(self, current_time):
        """Check for motor command timeout (safety feature)"""
        timeout = self.cfg.get("safety", {}).get("motor_cmd_timeout", 0.1)
        if current_time - self.last_motor_cmd_time > timeout:
            if not hasattr(self, 'motor_cmd_timeout_warned'):
                self.logger.warning("Motor command timeout - no commands received")
                self.motor_cmd_timeout_warned = True
                # Could implement emergency stop here
                # self._emergency_stop()
    
    def _check_joint_limits(self):
        """Check joint velocity and torque limits (safety feature)"""
        if not hasattr(self, 'dof_vel') or not hasattr(self, 'dof_pos'):
            return
        
        max_velocity = self.cfg.get("safety", {}).get("max_joint_velocity", 10.0)
        max_torque = self.cfg.get("safety", {}).get("max_joint_torque", 100.0)
        
        # Check velocity limits
        for i, vel in enumerate(self.dof_vel):
            if abs(vel) > max_velocity:
                self.logger.warning(f"Joint {i} velocity limit exceeded: {vel:.2f} > {max_velocity}")
                # Could implement emergency stop here
                # self._emergency_stop()
                break
        
        # Check torque limits (if we have torque data)
        if hasattr(self, 'latest_motor_cmd') and self.latest_motor_cmd:
            for i, torque in enumerate(self.latest_motor_cmd.joint_torques):
                if abs(torque) > max_torque:
                    self.logger.warning(f"Joint {i} torque limit exceeded: {torque:.2f} > {max_torque}")
                    # Could implement emergency stop here
                    # self._emergency_stop()
                    break
    
    def _emergency_stop(self):
        """Emergency stop procedure"""
        self.logger.error("EMERGENCY STOP ACTIVATED")
        self.running = False
        
        if BOOSTER_SDK_AVAILABLE:
            try:
                # Switch to damping mode for safety
                self.client.ChangeMode(RobotMode.kDamping)
                self.logger.info("Robot switched to damping mode")
            except Exception as e:
                self.logger.error(f"Failed to switch to damping mode: {e}")
    
    
    def _send_cmd(self, cmd: LowCmd):
        """Send command to robot (wrapper function like deploy.py)"""
        self.low_cmd_publisher.Write(cmd)
    
    
    def _log_statistics(self):
        """Log system statistics"""
        self.logger.info("=" * 50)
        self.logger.info("HARDWARE BRIDGE STATISTICS")
        self.logger.info("=" * 50)
        self.logger.info(f"Sensor data messages: {self.sensor_data_count}")
        self.logger.info(f"Motor command messages: {self.motor_cmd_count}")
        self.logger.info(f"Robot mode: {self.robot_mode}")
        self.logger.info(f"SDK available: {BOOSTER_SDK_AVAILABLE}")
        self.logger.info("=" * 50)
    
    def cleanup(self):
        """Cleanup resources"""
        self.running = False

        # Switch back to damping mode for safety
        if BOOSTER_SDK_AVAILABLE:
            try:
                self.client.ChangeMode(RobotMode.kDamping)
                self.logger.info("Switched to damping mode for safety")
            except Exception as e:
                self.logger.error(f"Failed to switch to damping mode: {e}")
        
        # Close SDK channels
        if hasattr(self, "low_cmd_publisher"):
            self.low_cmd_publisher.CloseChannel()
        if hasattr(self, "low_state_subscriber"):
            self.low_state_subscriber.CloseChannel()
        
        self.logger.info("Booster Hardware Bridge cleanup completed")


def main(args=None):
    rclpy.init(args=args)
    
    try:
        # Parse command line arguments for config file
        import argparse
        parser = argparse.ArgumentParser(description='Booster Hardware Bridge')
        parser.add_argument('--config', type=str, help='Path to configuration file')
        args = parser.parse_args()
        
        bridge = BoosterHardwareBridge(config_file=args.config)
        
        # Wait for channels to initialize
        time.sleep(2)
        print("Initialization complete.")
        print("Use ROS2 service calls to control robot modes:")
        print("  ros2 service call /booster/robot_mode '{mode: 0}'  # Damping mode (default)")
        print("  ros2 service call /booster/robot_mode '{mode: 1}'  # Custom mode")
        print("  ros2 service call /booster/robot_mode '{mode: 2}'  # RL mode (from custom)")
        print("Mode transitions: Any->Damping, Any->Custom, Custom->RL")
        print("Motor commands are only processed in RL mode (mode 2).")

        # Handle shutdown gracefully
        def shutdown_handler():
            bridge.cleanup()
            rclpy.shutdown()
        
        import signal
        signal.signal(signal.SIGINT, lambda sig, frame: shutdown_handler())
        signal.signal(signal.SIGTERM, lambda sig, frame: shutdown_handler())
        
        rclpy.spin(bridge)
        
    except KeyboardInterrupt:
        pass
    except Exception as e:
        print(f"Error: {e}")
    finally:
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()

