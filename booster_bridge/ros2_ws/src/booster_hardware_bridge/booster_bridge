class BoosterHardwareBridge(Node):
    """
    Hardware Bridge Node
    Bridges Booster SDK with ROS2 communication
    This is the minimal hardware interface that runs on the robot.
    Based on deploy.py but separated into ROS2 communication.
    """
    
    def __init__(self, config_file: str = None):
        super().__init__('booster_hardware_bridge')
        
        # Setup logging
        logging.basicConfig(level=logging.INFO)
        self.logger = logging.getLogger(__name__)
    
        # Load configuration
        self.cfg = self._load_config(config_file)
        
        # ROS2 QoS profile for real-time communication
        qos_profile = QoSProfile(
            reliability=ReliabilityPolicy.BEST_EFFORT,
            durability=DurabilityPolicy.VOLATILE,
            depth=1
        )
        
        # Initialize state variables (from deploy.py)
        self.running = True
        self.robot_mode = 0  # kDamping (start in damping mode)
        self.latest_motor_cmd: Optional[BoosterMotorCmd] = None
        self.last_motor_cmd_time = 0.0
        self.motor_cmd_timeout = 0.1  # 100ms timeout
        
        # Mode flags for state tracking
        self.custom_mode_started = False
        self.rl_mode_started = False
        
        # Initialize sensor data arrays (from deploy.py)
        self._init_sensor_data_arrays()
        
        # Statistics
        self.sensor_data_count = 0
        self.motor_cmd_count = 0
        self.last_stats_time = 0.0
        
        # Initialize Booster SDK
        if BOOSTER_SDK_AVAILABLE:
            self._init_booster_sdk()
        
        # Initialize ROS2 communication
        self._init_ros2_communication(qos_profile)
        
        # Control loop timer (500Hz like deploy.py)
        self.control_timer = self.create_timer(0.002, self.control_loop)
        
        self.logger.info("Booster Hardware Bridge initialized")
        if BOOSTER_SDK_AVAILABLE:
            self.logger.info("Running with Booster SDK")
        else:
            self.logger.info("Running in simulation mode")
    
    def _load_config(self, config_file: str = None):
        """Load configuration file (from deploy.py)"""
        if config_file is None:
            # Use the same config as deploy.py
            config_file = "/home/booster/Workspace/booster_sim2real/deploy_booster/configs/T1.yaml"
        
        try:
            with open(config_file, "r", encoding="utf-8") as f:
                cfg = yaml.load(f.read(), Loader=yaml.FullLoader)
            self.logger.info(f"Loaded configuration from {config_file}")
            return cfg
        except FileNotFoundError:
            self.logger.warning(f"Config file {config_file} not found, using defaults")
            return self._get_default_config()
        except Exception as e:
            self.logger.error(f"Failed to load config: {e}")
            return self._get_default_config()
    
    def _get_default_config(self):
        """Get default configuration (from T1.yaml)"""
        return {
            "common": {
                "dt": 0.002,
                "stiffness": [20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 200, 200, 200, 200, 200, 50, 50, 200, 200, 200, 200, 50, 50],
                "damping": [0.2, 0.2, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 5, 5, 5, 5, 5, 3, 3, 5, 5, 5, 5, 3, 3],
                "default_qpos": [0, 0, 0.2, -1.35, 0, -0.5, 0.2, 1.35, 0, 0.5, 0, -0.2, 0, 0, 0.4, -0.25, 0, -0.2, 0, 0, 0.4, -0.25, 0],
                "torque_limit": [7, 7, 10, 10, 10, 10, 10, 10, 10, 10, 30, 60, 25, 30, 60, 24, 15, 60, 25, 30, 60, 24, 15]
            },
            "mech": {
                "parallel_mech_indexes": [15, 16, 21, 22]
            }
        }
    
    def _init_sensor_data_arrays(self):
        """Initialize sensor data arrays (from deploy.py)"""
        self.base_ang_vel = np.zeros(3, dtype=np.float32)
        self.dof_pos = np.zeros(B1JointCnt, dtype=np.float32)
        self.dof_vel = np.zeros(B1JointCnt, dtype=np.float32)
        self.dof_pos_latest = np.zeros(B1JointCnt, dtype=np.float32)
        
        # Add filtering arrays (from deploy.py)
        self.dof_target = np.zeros(B1JointCnt, dtype=np.float32)
        self.filtered_dof_target = np.zeros(B1JointCnt, dtype=np.float32)
        self.filtering_initialized = False
        
        # Add mode switching state
        self.custom_mode_started = False

    
    def _init_booster_sdk(self):
        """Initialize Booster SDK (SAME AS deploy.py)"""
        try:
            # Initialize SDK (SAME AS deploy.py)
            ChannelFactory.Instance().Init(0)
            
            # Create SDK objects (SAME AS deploy.py)
            self.low_cmd = LowCmd()
            self.low_state_subscriber = B1LowStateSubscriber(self._low_state_handler)
            self.low_cmd_publisher = B1LowCmdPublisher()
            self.client = B1LocoClient()
            
            # Initialize channels (SAME AS deploy.py)
            self.low_state_subscriber.InitChannel()
            self.low_cmd_publisher.InitChannel()
            self.client.Init()
            
            self.logger.info("Booster SDK initialized successfully")
            
        except Exception as e:
            self.logger.error(f"Failed to initialize Booster SDK: {e}")
            raise
    
    
    def _init_ros2_communication(self, qos_profile):
        """Initialize ROS2 communication"""
        # ROS2 Publishers and Subscribers
        self.sensor_data_publisher = self.create_publisher(
            BoosterSensorData, 'booster/sensor_data', qos_profile
        )
        
        self.motor_cmd_subscriber = self.create_subscription(
            BoosterMotorCmd, 'booster/motor_cmd', self.motor_cmd_callback, qos_profile
        )
        
        
        # Robot mode service
        self.robot_mode_service = self.create_service(
            BoosterRobotMode, 'booster/robot_mode', self.robot_mode_callback
        )
    
    def _low_state_handler(self, low_state_msg: LowState):
        """Process sensor data from Booster SDK (SAME AS deploy.py)"""
        # Debug: Print array sizes
        self.logger.debug(f"Low state received - motor_state_serial length: {len(low_state_msg.motor_state_serial)}")
        self.logger.debug(f"dof_pos_latest size: {len(self.dof_pos_latest)}, dof_pos size: {len(self.dof_pos)}")
        
        # Safety check (SAME AS deploy.py)
        if abs(low_state_msg.imu_state.rpy[0]) > 1.0 or abs(low_state_msg.imu_state.rpy[1]) > 1.0:
            self.logger.warning("IMU base rpy values are too large: {}".format(low_state_msg.imu_state.rpy))
            self.running = False
            return
        
        # Update latest joint positions (SAME AS deploy.py)
        self.logger.debug(f"Updating joint positions, motor_state_serial length: {len(low_state_msg.motor_state_serial)}, dof_pos_latest length: {len(self.dof_pos_latest)}")
        for i, motor in enumerate(low_state_msg.motor_state_serial):
            self.logger.debug(f"Updating joint {i}, dof_pos_latest length: {len(self.dof_pos_latest)}")
            self.dof_pos_latest[i] = motor.q
        
        self.base_ang_vel[:] = low_state_msg.imu_state.gyro
        
        for i, motor in enumerate(low_state_msg.motor_state_serial):
            self.dof_pos[i] = motor.q
            self.dof_vel[i] = motor.dq
        
        # Convert LowState to BoosterSensorData
        sensor_data = BoosterSensorData()
        
        # IMU data (SAME AS deploy.py)
        sensor_data.imu_rpy = list(low_state_msg.imu_state.rpy)
        sensor_data.imu_gyro = list(low_state_msg.imu_state.gyro)
        sensor_data.imu_acc = list(low_state_msg.imu_state.acc)
        
        # Joint data (SAME AS deploy.py)
        self.logger.debug(f"Setting sensor data joint arrays, motor_state_serial length: {len(low_state_msg.motor_state_serial)}")
        self.logger.debug(f"sensor_data.joint_positions length: {len(sensor_data.joint_positions)}")
        for i, motor in enumerate(low_state_msg.motor_state_serial):
            sensor_data.joint_positions[i] = motor.q
            sensor_data.joint_velocities[i] = motor.dq
            sensor_data.joint_torques[i] = motor.tau_est
        
        # Timestamp
        sensor_data.timestamp = self.get_clock().now().to_msg()
        
        # Publish to ROS2
        self.sensor_data_publisher.publish(sensor_data)
        self.sensor_data_count += 1
    
    def motor_cmd_callback(self, msg: BoosterMotorCmd):
        """Process motor commands from ROS2 - only in RL mode"""
        # Only accept motor commands when in RL mode (2)
        if self.robot_mode != 2:
            if not hasattr(self, 'motor_cmd_rejected_warned') or not self.motor_cmd_rejected_warned:
                mode_names = {0: "Damping", 1: "Custom", 2: "RL"}
                self.logger.warning(f"Motor command rejected - robot is in {mode_names[self.robot_mode]} mode, need RL mode")
                self.motor_cmd_rejected_warned = True
            return
        
        # Reset warning flag when in RL mode
        if hasattr(self, 'motor_cmd_rejected_warned'):
            self.motor_cmd_rejected_warned = False
        
        self.latest_motor_cmd = msg
        self.last_motor_cmd_time = time.time()
        self.motor_cmd_count += 1
        
        # Debug: Print array sizes
        self.logger.info(f"Motor command received - joint_positions: {len(msg.joint_positions)}, joint_kp: {len(msg.joint_kp)}, joint_kd: {len(msg.joint_kd)}")
        self.logger.info(f"dof_target size: {len(self.dof_target)}, filtered_dof_target size: {len(self.filtered_dof_target)}")
        
        if BOOSTER_SDK_AVAILABLE:
            # Initialize motor_cmd array if not already done
            if len(self.low_cmd.motor_cmd) == 0:
                self.logger.info("Initializing motor_cmd array with 23 MotorCmd objects")
                motor_cmds = [MotorCmd() for _ in range(B1JointCnt)]
                self.low_cmd.motor_cmd = motor_cmds
                for i in range(B1JointCnt):
                    self.low_cmd.motor_cmd[i].q = 0.0
                    self.low_cmd.motor_cmd[i].dq = 0.0
                    self.low_cmd.motor_cmd[i].tau = 0.0
                    self.low_cmd.motor_cmd[i].kp = 0.0
                    self.low_cmd.motor_cmd[i].kd = 0.0
                    self.low_cmd.motor_cmd[i].weight = 0.0
            
            # Convert BoosterMotorCmd to LowCmd
            #self.low_cmd.cmd_type = msg.cmd_type
            
            # Apply moving average filtering (from deploy.py)
            # Store new target positions
            for i in range(23):
                self.dof_target[i] = msg.joint_positions[i]
            
            # Initialize filtering on first command (same as deploy.py)
            if not self.filtering_initialized:
                self.filtered_dof_target[:] = self.dof_target[:]
                self.filtering_initialized = True
                self.logger.info("Initialized motor command filtering")
            else:
                # Apply exponential moving average filter: filtered = 0.8 * previous + 0.2 * new
                self.filtered_dof_target = self.filtered_dof_target * 0.8 + self.dof_target * 0.2
            
            # Set joint commands from filtered targets
            self.logger.info(f"Setting joint commands, motor_cmd array length: {len(self.low_cmd.motor_cmd)}")
            for i in range(23):
                self.logger.debug(f"Setting motor_cmd[{i}], motor_cmd length: {len(self.low_cmd.motor_cmd)}")
                self.low_cmd.motor_cmd[i].q = self.filtered_dof_target[i]
            
            # Handle parallel mechanism joints (torque control)
            if "parallel_mech_indexes" in self.cfg.get("mech", {}):
                for i in self.cfg["mech"]["parallel_mech_indexes"]:
                    # For parallel mechanism joints, use position feedback and torque control
                    self.low_cmd.motor_cmd[i].q = self.dof_pos_latest[i]
                    self.low_cmd.motor_cmd[i].tau = np.clip(
                        (self.filtered_dof_target[i] - self.dof_pos_latest[i]) * msg.joint_kp[i],
                        -self.cfg["common"]["torque_limit"][i],
                        self.cfg["common"]["torque_limit"][i],
                    )
                    self.low_cmd.motor_cmd[i].kp = 0.0
            
            # Don't send directly - let control loop handle it
            # self.low_cmd_publisher.Write(self.low_cmd)
        else:
            # In simulation mode, just log the command
            self.logger.debug(f"SIMULATION MODE: Received motor command: {len(msg.joint_positions)} joints")
    
    
    def robot_mode_callback(self, request, response):
        """Handle robot mode switching with proper state transitions"""
        try:
            target_mode = request.mode
            current_mode = self.robot_mode
            
            # Define mode names for logging
            mode_names = {0: "Damping", 1: "Custom", 2: "RL"}
            
            # Check if transition is valid
            if not self._is_valid_mode_transition(current_mode, target_mode):
                response.success = False
                response.message = f"Invalid transition from {mode_names[current_mode]} to {mode_names[target_mode]}"
                self.logger.error(f"Invalid mode transition: {current_mode} -> {target_mode}")
                return response
            
            # Execute mode transition
            if BOOSTER_SDK_AVAILABLE:
                success = self._execute_mode_transition(target_mode)
                if not success:
                    response.success = False
                    response.message = f"Failed to switch to {mode_names[target_mode]} mode"
                    return response
            
            # Update internal state
            self.robot_mode = target_mode
            
            # Reset mode-specific flags
            if target_mode == 0:  # Damping
                self.custom_mode_started = False
                self.rl_mode_started = False
            elif target_mode == 1:  # Custom
                self.rl_mode_started = False
            
            # Reset warning flags
            if hasattr(self, 'mode_warning_logged'):
                self.mode_warning_logged = False
            
            response.success = True
            response.message = f"Successfully switched to {mode_names[target_mode]} mode"
            self.logger.info(f"Robot mode changed: {mode_names[current_mode]} -> {mode_names[target_mode]}")
            
        except Exception as e:
            response.success = False
            response.message = f"Mode setting failed: {e}"
            self.logger.error(f"Mode setting failed: {e}")
        
        return response
    
    def _is_valid_mode_transition(self, current_mode, target_mode):
        """Check if mode transition is valid based on state machine rules"""
        # Can always go to damping (0) from any mode
        if target_mode == 0:
            return True
        
        # Can always go to custom (1) from any mode
        if target_mode == 1:
            return True
        
        # Can only go to RL (2) from custom (1)
        if target_mode == 2:
            return current_mode == 1
        
        return False
    
    def _execute_mode_transition(self, target_mode):
        """Execute the actual mode transition using Booster SDK"""
        try:
            if not BOOSTER_SDK_AVAILABLE:
                self.logger.error("Booster SDK not available - cannot execute mode transition")
                return False
            
            if target_mode == 0:  # Damping
                self.logger.info("Executing Damping mode transition...")
                self.client.ChangeMode(RobotMode.kDamping)
                self.logger.info("Switched to Damping mode")
                
            elif target_mode == 1:  # Custom
                self.logger.info("Executing Custom mode transition...")
                # Create prepare command and send it
                self._create_prepare_cmd()
                self.logger.info("Sending prepare command...")
                self.low_cmd_publisher.Write(self.low_cmd)
                self.client.ChangeMode(RobotMode.kCustom)
                self.logger.info("Switched to Custom mode")
                
            elif target_mode == 2:  # RL
                self.logger.info("Executing RL mode transition...")
                # Create prepare command and send it
                self._create_prepare_cmd()
                self.logger.info("Sending prepare command...")
                self.low_cmd_publisher.Write(self.low_cmd)
                self.client.ChangeMode(RobotMode.kCustom)  # RL uses Custom mode in SDK
                self.logger.info("Switched to RL mode")
            
            return True
            
        except Exception as e:
            self.logger.error(f"Failed to execute mode transition to {target_mode}: {e}")
            import traceback
            self.logger.error(f"Traceback: {traceback.format_exc()}")
            return False
    
    def _create_prepare_cmd(self):
        """Create prepare command (SAME AS deploy.py)"""
        # Initialize command
        self.low_cmd.cmd_type = LowCmdType.SERIAL
        
        # Initialize motor_cmd array if not already done
        if len(self.low_cmd.motor_cmd) == 0:
            self.logger.info("Initializing motor_cmd array for prepare command")
            motor_cmds = [MotorCmd() for _ in range(B1JointCnt)]
            self.low_cmd.motor_cmd = motor_cmds
            for i in range(B1JointCnt):
                self.low_cmd.motor_cmd[i].q = 0.0
                self.low_cmd.motor_cmd[i].dq = 0.0
                self.low_cmd.motor_cmd[i].tau = 0.0
                self.low_cmd.motor_cmd[i].kp = 0.0
                self.low_cmd.motor_cmd[i].kd = 0.0
                self.low_cmd.motor_cmd[i].weight = 0.0
        
        # Set prepare parameters (SAME AS deploy.py)
        prepare_cfg = self.cfg.get("prepare", {})
        if prepare_cfg:
            for i in range(23):
                self.low_cmd.motor_cmd[i].kp = prepare_cfg.get("stiffness", [0.0] * 23)[i]
                self.low_cmd.motor_cmd[i].kd = prepare_cfg.get("damping", [0.0] * 23)[i]
                self.low_cmd.motor_cmd[i].q = prepare_cfg.get("default_qpos", [0.0] * 23)[i]
        else:
            # Use common parameters as fallback
            for i in range(23):
                self.low_cmd.motor_cmd[i].kp = self.cfg["common"]["stiffness"][i]
                self.low_cmd.motor_cmd[i].kd = self.cfg["common"]["damping"][i]
                self.low_cmd.motor_cmd[i].q = self.cfg["common"]["default_qpos"][i]
    
